# 백엔드 API (workation-backend). 개발 서버는 /api 를 이 주소로 proxy 하고(쿠키 same-origin),
# 빌드 결과는 이 주소를 직접 호출한다. 복사해서 .env 로 사용
VITE_API_BASE_URL=http://localhost:8000

# 'true' 면 백엔드 없이 src/mocks 데이터로 동작 (E2E·시연용)
VITE_USE_MOCK=true

# Google Maps JavaScript API 키 (W-04 위치 지도, W-01 히트맵). 비어 있으면 플레이스홀더로 동작
VITE_GOOGLE_MAPS_KEY=
# AdvancedMarker 용 Map ID (Cloud Console). 비어 있으면 개발용 DEMO_MAP_ID
VITE_GOOGLE_MAPS_MAP_ID=
